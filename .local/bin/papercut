#!/bin/sh
set -eu

[ "$#" -gt 0 ] || {
  printf 'usage: papercut <message>\n' >&2
  exit 1
}

log="$HOME/.agents/PAPERCUTS.md"
mkdir -p "${log%/*}"
[ -f "$log" ] || printf '# Papercuts\n\n' >"$log"

printf '## %s — %s:%s\n\n%s\n\n' \
  "$(date '+%Y-%m-%d %H:%M:%S')" \
  "$(hostname)" \
  "$PWD" \
  "$*" >>"$log"
